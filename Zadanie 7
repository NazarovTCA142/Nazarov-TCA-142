#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>

using namespace std;

/**
*@brief - функция ввода значения с клавиатуры, прерывает программу в случае некорректного ввода
*/
int getNumber();

/**
*@brief - функция для заполнения массива случайными числами из задаваемого диапазона
*@param - массив
*/
void fillRandom(vector<vector<int>>& arr);

/**
*@brief - функция для заполнения массива пользователем
*@param - массив
*/
void fillFromInput(vector<vector<int>>& arr);

/**
*@brief - функция для замены нечётных элементов на 0
*@param - массив
*/
void replaceOddWithZero(vector<vector<int>>& arr);

/**
*@brief - Функция для вставки первого столбца после столбцов, содержащих нулевой элемент
*@param - массив
*/
void insertFirstColumnAfterZeros(vector<vector<int>>& arr);

/**
*@brief - Функция для вывода массива на экран
*@param - массив
*/
void printArray(const vector<vector<int>>& arr);

/**
*@brief - функция для беззнакового числа
*@return - число
*/
size_t getSize();

/**
*@brief - главная функция программы
*@return - возвращает 0 в случае успеха, иначе 1
*/

int main() {
    cout << "Введите количество строк и столбцов: ";
    int n = getSize();
    int m = getSize();

    vector<vector<int>> array(n, vector<int>(m));

    cout << "Выберите способ заполнения массива:\n1 - случайные числа\n2 - ввод с клавиатуры\n>>> ";
    int choice = getNumber();
    switch (choice) {
        case 1:
            fillRandom(array);
            break;
        case 2:
            fillFromInput(array);
            break;
        default:
            cout << "Неверный вариант выбора." << endl;
            return 1;
    }

    cout << "Массив до преобразований:" << endl;
    printArray(array);
    
    vector<vector<int>> array2(n, vector<int>(m));
    copy(array.begin(), array.end(), array2.begin());
    replaceOddWithZero(array2);
    cout << "\nМассив после замены нечетных элементов на 0:" << endl;
    printArray(array2);

    vector<vector<int>> array3(n, vector<int>(m));
    copy(array2.begin(), array2.end(), array3.begin());
    insertFirstColumnAfterZeros(array3);
    cout << "\nМассив вставки первго столбца после каждого, содержащего 0:" << endl;
    printArray(array3);
    return 0;
}

int getNumber()
{
    double number;
  cin >> number;
  if (cin.fail())
  {
    cout<<"incorrect input"<<endl;
    abort();
  }
  return number;
}

void fillRandom(vector<vector<int>>& arr) {
    srand(time(0));
    cout << "Введите диапазон значений: ";
    int min = getNumber();
    int max = getNumber();
    for (size_t i = 0; i < arr.size(); ++i) {
        for (size_t j = 0; j < arr[0].size(); ++j) {
            arr[i][j] = rand() % (max - min + 1) + min; 
        }
    }
}

void fillFromInput(vector<vector<int>>& arr) {
    for (size_t i = 0; i < arr.size(); ++i) {
        cout << "Введите " << arr[0].size() << " чисел для строки " << i << ":" << endl;
        for (size_t j = 0; j < arr[0].size(); ++j) {
            cin >> arr[i][j];
        }
    }
}

void replaceOddWithZero(vector<vector<int>>& arr) {
    for (size_t i = 0; i < arr.size(); ++i) {
        for (size_t j = 0; j < arr[0].size(); ++j) {
            if (arr[i][j] % 2 != 0) {
                arr[i][j] = 0;
            }
        }
    }
}

void insertFirstColumnAfterZeros(vector<vector<int>>& arr) {
    for (size_t j = arr[0].size() - 1; j >= 0; --j) {
        bool foundZero = false;
        for (size_t i = 0; i < arr.size(); ++i) {
            if (arr[i][j] == 0) {
                foundZero = true;
                break;
            }
        }
        if (foundZero) {
            // Вставляем первый столбец после столбца с нулями
            for (size_t i = 0; i < arr.size(); ++i) {
                arr[i].insert(arr[i].begin() + j + 1, arr[i][0]);
            }
        }
    }
}

void printArray(const vector<vector<int>>& arr) {
    for (size_t i = 0; i < arr.size(); ++i) {
        for (size_t j = 0; j < arr[0].size(); ++j) {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }
}

